---
import { getEntry } from 'astro:content';
import { url } from '../lib/url';

const site = (await getEntry('site', 'site'))!.data;
---

<footer class="border-t border-line">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-6 px-5 py-12 sm:px-8">
    <a href={url('')} class="flex items-center gap-2">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent font-serif text-base font-bold text-surface">
        K
      </span>
      <span class="font-serif text-lg font-semibold">Kadafi’s Blog</span>
    </a>

    <p class="max-w-md text-center text-sm text-muted">{site.description}</p>

    <div class="flex items-center gap-3">
      {site.social.map((s) => (
        <a
          href={s.link}
          target="_blank"
          rel="noopener"
          aria-label={s.name}
          class="grid h-10 w-10 place-items-center rounded-full border border-line text-muted transition hover:border-accent hover:text-accent"
        >
          <i class={`text-lg bi ${s.icon}`}></i>
        </a>
      ))}
    </div>

    <p class="text-xs text-muted">
      © {new Date().getFullYear()} {site.author}. Built with Astro.
    </p>
  </div>
</footer>