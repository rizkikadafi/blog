---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  post: CollectionEntry<'posts'>;
  seriesPosts: CollectionEntry<'posts'>[];
}

const { post, seriesPosts } = Astro.props;

const ordered = [...seriesPosts].sort((a, b) => (a.data.series_order ?? 0) - (b.data.series_order ?? 0));
const idx = ordered.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;
---

<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
  {prev ? (
    <a
      href={url(`blog/${prev.id}/`)}
      class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2 text-sm transition hover:border-accent hover:text-accent"
    >
      <i class="bi bi-arrow-left"></i>
      Prev
    </a>
  ) : (
    <span class="inline-flex items-center gap-2 rounded-full border border-line/50 px-5 py-2 text-sm text-muted opacity-50">
      <i class="bi bi-arrow-left"></i>
      Prev
    </span>
  )}

  {post.data.series_title && (
    <a
      href={url(`series/${post.data.series_title}/`)}
      class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent-soft px-5 py-2 text-sm font-medium text-accent transition hover:bg-accent-hover"
    >
      <i class="bi bi-collection"></i>
      Series
    </a>
  )}

  {next ? (
    <a
      href={url(`blog/${next.id}/`)}
      class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2 text-sm transition hover:border-accent hover:text-accent"
    >
      Next
      <i class="bi bi-arrow-right"></i>
    </a>
  ) : (
    <span class="inline-flex items-center gap-2 rounded-full border border-line/50 px-5 py-2 text-sm text-muted opacity-50">
      Next
      <i class="bi bi-arrow-right"></i>
    </span>
  )}
</div>