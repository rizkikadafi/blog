---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const src = post.data.thumbnail ? url(`assets/images/posts/${post.data.thumbnail}`) : null;
const href = url(`blog/${post.id}/`);
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article
  class="flex flex-col overflow-hidden rounded-xl border border-line bg-card transition duration-300 hover:-translate-y-1 hover:border-accent/60"
>
  {src && (
    <a href={href} class="block overflow-hidden">
      <img
        src={src}
        alt={post.data.title}
        loading="lazy"
        class="h-44 w-full object-cover transition duration-300 hover:scale-105"
      />
    </a>
  )}

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex items-center gap-2 text-xs text-accent">
      {post.data.categories.map((cat) => (
        <a href={url(`categories/${cat}/`)} class="uppercase tracking-wide hover:underline">
          {cat.replaceAll('-', ' ')}
        </a>
      ))}
    </div>

    <h3 class="font-serif text-xl font-semibold leading-snug">
      <a href={href} class="transition hover:text-accent">{post.data.title}</a>
    </h3>

    <p class="mt-2 text-xs text-muted">
      {date} · {post.data.author}
    </p>

    <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">
      {post.data.description}
    </p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {post.data.tags.map((tag) => (
        <span class="rounded-full bg-surface px-2.5 py-1 text-xs text-muted">{tag}</span>
      ))}
    </div>

    <a
      href={href}
      class="group mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline"
    >
      Read more
      <i class="bi bi-arrow-right transition group-hover:translate-x-1"></i>
    </a>
  </div>
</article>