---
import { url } from '../lib/url';

interface Props {
  tags: string[];
  hrefable?: boolean;
}

const { tags, hrefable = true } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag) =>
    hrefable ? (
      <a
        href={url(`tags/${tag}/`)}
        class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted transition hover:border-accent hover:text-accent"
      >
        #{tag}
      </a>
    ) : (
      <span
        class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted"
      >
        #{tag}
      </span>
    ),
  )}
</div>