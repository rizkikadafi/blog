---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="404">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center px-5 py-32 text-center sm:px-8">
    <p class="font-serif text-7xl font-bold text-accent sm:text-9xl">404</p>
    <h1 class="mt-6 font-serif text-2xl font-semibold sm:text-3xl">Page not found</h1>
    <p class="mt-3 max-w-md text-sm text-muted">
      The page you’re looking for doesn’t exist or has been moved.
    </p>
    <a
      href={url('')}
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-surface transition hover:brightness-110"
    >
      <i class="bi bi-house"></i>
      Back to Home
    </a>
  </div>
</BaseLayout>