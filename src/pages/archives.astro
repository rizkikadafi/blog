---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Alert from '../components/Alert.astro';
import { url } from '../lib/url';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const year = p.data.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(p);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="Archives" description="A chronological archive of all blog posts.">
  <div class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-8">
    <SectionHeading title="Archives" subtitle="Every post, in chronological order" />

    {posts.length > 0 ? (
      <div class="space-y-10">
        {years.map(([year, yearPosts]) => (
          <div>
            <h2 class="mb-4 border-b border-line pb-2 font-serif text-2xl font-semibold text-accent">
              {year}
            </h2>
            <ul class="divide-y divide-line">
              {yearPosts.map((post) => (
                <li>
                  <a
                    href={url(`blog/${post.id}/`)}
                    class="group flex items-baseline gap-4 py-3 transition"
                  >
                    <span class="w-10 shrink-0 text-sm text-muted">
                      {post.data.date.toLocaleDateString('en-US', { month: 'short', day: '2-digit' })}
                    </span>
                    <span class="flex-1 font-medium transition group-hover:text-accent">
                      {post.data.title}
                    </span>
                    <i class="bi bi-arrow-up-right text-muted transition group-hover:text-accent"></i>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <div class="flex justify-center">
        <Alert type="info" message="No Archives Available" />
      </div>
    )}
  </div>
</BaseLayout>